{
  "name": "@shareawish/mcp",
  "version": "0.1.0",
  "description": "MCP servers for Share a Wish: build creator shops (lists, products with affiliate links, videos) and integrate the wishlist basket/save button (API keys, basket configs, snippets) from Claude, Cursor, Copilot and other MCP clients.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shareawish-creator-mcp": "./dist/creator.js",
    "shareawish-wishlist-mcp": "./dist/wishlist.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "start:creator": "node dist/creator.js",
    "start:wishlist": "node dist/wishlist.js",
    "e2e:creator": "node scripts/e2e-creator.mjs",
    "e2e:wishlist": "node scripts/e2e-wishlist.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run smoke"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "homepage": "https://shareawish.shop/developers/mcp/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shareawish/mcp"
  },
  "bugs": {
    "url": "https://github.com/shareawish/mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shareawish",
    "wishlist",
    "affiliate",
    "creator",
    "shopify",
    "ecommerce",
    "claude",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  }
}
